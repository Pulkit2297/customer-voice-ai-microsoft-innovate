table 'public reviews'
	lineageTag: 86e10d79-57c2-4c2e-81ce-e97281316bcf

	measure 'Total Reviews' = COUNTROWS('public reviews')
		formatString: #,##0
		lineageTag: 1045d353-8709-4dca-abd3-b44c2c12a97e

	measure 'Positive Reviews' = CALCULATE(COUNTROWS('public reviews'), 'public sentiment_results'[sentiment] = "positive")
		formatString: #,##0
		lineageTag: 227e18c5-9506-42e9-bc33-6dda55159cca

	measure 'Negative Reviews' = CALCULATE(COUNTROWS('public reviews'), 'public sentiment_results'[sentiment] = "negative")
		formatString: #,##0
		lineageTag: 0e8aad58-0ecd-4ce8-bc92-38e06e4d78a3

	measure 'Neutral Reviews' = CALCULATE(COUNTROWS('public reviews'), 'public sentiment_results'[sentiment] = "neutral")
		formatString: #,##0
		lineageTag: fcdae94f-69e2-4c04-a210-f4d8b6106a99

	measure 'Positive Sentiment %' = DIVIDE([Positive Reviews], [Total Reviews], 0)
		formatString: 0.0%
		lineageTag: 025da361-9c6c-47fa-b634-b0ab890a4a9b

	measure 'Negative Sentiment %' = DIVIDE([Negative Reviews], [Total Reviews], 0)
		formatString: 0.0%
		lineageTag: 6e964646-1257-4f98-a3d5-fa146b84e3ee

	measure 'Neutral Sentiment %' = DIVIDE([Neutral Reviews], [Total Reviews], 0)
		formatString: 0.0%
		lineageTag: 8ce58a43-aa21-4cad-af80-f8895b9d2308

	measure 'Net Sentiment Score' = [Positive Sentiment %] - [Negative Sentiment %]
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 5090672a-714a-40ff-a4dd-a5140dac6c00

	measure 'Average Sentiment Score' = AVERAGE('public sentiment_results'[sentiment_score])
		formatString: 0.00
		lineageTag: 68add898-d69c-40ce-b67e-6f29deb5097d

	measure 'Average Confidence' = AVERAGE('public sentiment_results'[confidence])
		formatString: 0.0%
		lineageTag: 7d92ed66-fefc-4bd0-acce-bdbe28a0911c

	measure 'PII Redacted Reviews' = CALCULATE(COUNTROWS('public reviews'), 'public reviews'[pii_detected] = TRUE())
		formatString: #,##0
		lineageTag: c000d248-dacf-43fd-94f8-a3eb592890a7

	measure 'Total Complaints' = CALCULATE(COUNTROWS('public reviews'), 'public sentiment_results'[sentiment] = "negative")
		formatString: #,##0
		lineageTag: 45661aa7-94b2-43c1-b5a3-b11ce010519f

	measure 'Top Complaint Driver' = "product_quality (118)"
		lineageTag: 5730e617-1f17-45b1-9b64-371ae0813cfb

	measure 'Average Negative Intensity' = CALCULATE(AVERAGE('public sentiment_results'[sentiment_score]), 'public sentiment_results'[sentiment] = "negative")
		formatString: 0.00
		lineageTag: 85c7a6a9-09a2-49ef-a4ef-bc368633c068

	measure 'Amazon Reviews' = CALCULATE(COUNTROWS('public reviews'), 'public reviews'[source] = "Amazon")
		formatString: #,##0
		lineageTag: 21693d39-901b-44a5-ba4e-17c79f105d37

	measure 'Amazon Negative %' = DIVIDE(CALCULATE(COUNTROWS('public reviews'), 'public reviews'[source] = "Amazon", 'public sentiment_results'[sentiment] = "negative"), [Amazon Reviews], 0)
		formatString: 0.0%
		lineageTag: f325c56a-6115-4831-b866-b8d59d8b1b0a

	measure 'Twitter Reviews' = CALCULATE(COUNTROWS('public reviews'), 'public reviews'[source] = "Twitter/Social")
		formatString: #,##0
		lineageTag: 903848ce-1f90-4e7e-9796-1f3fc0543cc5

	measure 'Twitter Negative %' = DIVIDE(CALCULATE(COUNTROWS('public reviews'), 'public reviews'[source] = "Twitter/Social", 'public sentiment_results'[sentiment] = "negative"), [Twitter Reviews], 0)
		formatString: 0.0%
		lineageTag: f063be75-4ccf-47a3-83cd-2671ce382c50

	measure 'Data Lineage Notice' = "0 genuine product SKUs or marketing campaigns exist in the raw corpora. Columns preserved as NULL to prevent data fabrication. Channel and topical segmentation displayed."
		lineageTag: a9089743-296c-4637-9f7c-b78062c13323

	measure 'Active Alerts' = COALESCE(CALCULATE(COUNTROWS('public alerts'), 'public alerts'[status] = "ACTIVE"), 0)
		formatString: #,##0
		lineageTag: 02970255-eb64-492b-9a07-64feca0cfc37

	measure 'Temporal Trend Status' = IF(ISBLANK(MAX('public reviews'[review_date])), "INSUFFICIENT_TEMPORAL_DATA", "ACTIVE TIME SERIES")
		lineageTag: 5815179a-5958-4251-af05-eab28a0b8edf

	measure 'Alert Config: Negative Surge' = "Delta >= 20.0% / Rel >= 20.0%"
		lineageTag: b4286889-b35a-4f91-845f-568074b2a41a

	measure 'Alert Config: Topic Volume Surge' = "Increase >= 30.0% (Min Vol: 3)"
		lineageTag: b673e982-c39b-4d07-af1a-56349fc43fab

	measure 'Alert Config: Rating Drop' = "Drop >= 0.50 Stars"
		lineageTag: 3d697080-a023-4a40-9af3-7a9ed671c3fb

	measure 'Model Accuracy' = CALCULATE(MAX('public model_metrics'[metric_value]), 'public model_metrics'[evaluation_type] = "sentiment", 'public model_metrics'[metric_name] = "accuracy")
		formatString: 0.0%
		lineageTag: 18c26a91-deb8-4b7a-9a1b-1f41abfde7e0

	measure 'Model Macro F1' = CALCULATE(MAX('public model_metrics'[metric_value]), 'public model_metrics'[evaluation_type] = "sentiment", 'public model_metrics'[metric_name] = "macro_f1")
		formatString: 0.0000
		lineageTag: 802ee17f-0592-4ed9-99ee-86b17ded3976

	measure 'Model Weighted F1' = CALCULATE(MAX('public model_metrics'[metric_value]), 'public model_metrics'[evaluation_type] = "sentiment", 'public model_metrics'[metric_name] = "weighted_f1")
		formatString: 0.0000
		lineageTag: 1508e9a1-94a4-41df-904f-1d91a6409b1a

	measure 'Validation Sample Size' = CALCULATE(MAX('public model_metrics'[validation_sample_size]), 'public model_metrics'[evaluation_type] = "sentiment", 'public model_metrics'[metric_name] = "accuracy")
		formatString: #,##0
		lineageTag: 5e2012bc-ffab-4dc1-b731-ad5dc74a5b49


