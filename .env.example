# Application Configuration
APP_NAME="CustomerVoice AI"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Security / Authentication
SECRET_KEY=change-this-to-a-secure-secret-key-in-production

# ==============================================================================
# Database Configuration: Supabase PostgreSQL (Production Target)
# ==============================================================================
# CustomerVoice AI target production database is Supabase PostgreSQL.
#
# How to obtain your Supabase connection parameters:
# 1. Sign in to your Supabase project: https://supabase.com/dashboard/project/<project-ref>
# 2. Go to "Project Settings" (gear icon) -> "Database".
# 3. Scroll down to "Connection Parameters" / "Connection String".
# 4. Connection endpoints:
#    - Connection Pooling (Transaction Mode - Recommended for cloud deployments & APIs):
#      Host: aws-0-[region].pooler.supabase.com
#      Port: 6543
#      User: postgres.[project-ref]
#    - Direct Connection (Session Mode - for long-running batch jobs):
#      Host: db.[project-ref].supabase.co
#      Port: 5432
#      User: postgres
# 5. Database Name: postgres (default)
# 6. Password: The database password configured during project creation.
# 7. SSL Mode: sslmode=require (MANDATORY for Supabase cloud PostgreSQL)
#
# Production Connection URL Format (using psycopg2 driver):
# postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres.[project-ref]:your_password@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Direct Connection Alternative:
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@db.[project-ref].supabase.co:5432/postgres?sslmode=require

# Local PostgreSQL Development URL (Alternative for local Docker/Postgres instance):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/customervoice_db

# Isolated Automated Test Fixtures (SQLite in-memory):
# DATABASE_URL=sqlite:///:memory:
